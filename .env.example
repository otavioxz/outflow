# Copie este arquivo para .env e preencha. Tudo é opcional para começar:
# sem nada preenchido, o bot roda em modo simulação com um extrator simples.

# --- IA para entender as mensagens (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
# Modelo usado na extração. Para economizar, use claude-haiku-5-5.
CLAUDE_MODEL=claude-opus-5-5

# --- Transcrição de áudio (qualquer API compatível com a da OpenAI) ---
# OpenAI:  TRANSCRICAO_URL=https://api.openai.com/v1      TRANSCRICAO_MODELO=whisper-1
# Groq:    TRANSCRICAO_URL=https://api.groq.com/openai/v1 TRANSCRICAO_MODELO=whisper-large-v3-turbo  (tem plano gratuito)
TRANSCRICAO_API_KEY=
TRANSCRICAO_URL=https://api.openai.com/v1
TRANSCRICAO_MODELO=whisper-1

# --- WhatsApp Cloud API (deixe WHATSAPP_TOKEN vazio para o modo simulação) ---
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
VERIFY_TOKEN=invente-uma-senha-aqui
APP_SECRET=
GRAPH_VERSION=v23.0
# Seu número com DDI e DDD. Só mensagens dele são aceitas.
MEU_NUMERO=5511999999999

# --- Banco de dados ---
# Local: arquivo SQLite. Na nuvem: libsql://seu-banco.turso.io + DATABASE_AUTH_TOKEN
DATABASE_URL=file:financas.db
DATABASE_AUTH_TOKEN=

# --- Orçamento mensal em reais (opcional) ---
ORCAMENTO_MENSAL=3000
