# Copie este arquivo para .env e preencha. Tudo é opcional para começar:
# sem nada preenchido, o bot roda em modo simulação com um extrator simples.

# --- IA para entender as mensagens (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
# Modelo usado na extração. Para economizar, use claude-haiku-5-5.
CLAUDE_MODEL=claude-opus-5-5

# --- Ou interpretar as mensagens com o Groq (grátis). Usado quando não há ANTHROPIC_API_KEY.
# Se a transcrição já usa o Groq, a mesma chave serve e GROQ_API_KEY pode ficar vazio.
GROQ_API_KEY=
GROQ_MODELO=openai/gpt-oss-120b

# --- Transcrição de áudio (qualquer API compatível com a da OpenAI) ---
# OpenAI:  TRANSCRICAO_URL=https://api.openai.com/v1      TRANSCRICAO_MODELO=whisper-1
# Groq:    TRANSCRICAO_URL=https://api.groq.com/openai/v1 TRANSCRICAO_MODELO=whisper-large-v3-turbo  (tem plano gratuito)
TRANSCRICAO_API_KEY=
TRANSCRICAO_URL=https://api.openai.com/v1
TRANSCRICAO_MODELO=whisper-1

# --- WhatsApp Cloud API (deixe WHATSAPP_TOKEN vazio para o modo simulação) ---
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
# Em produção use 16+ caracteres aleatórios (ex.: node -e "console.log(crypto.randomUUID())")
VERIFY_TOKEN=invente-uma-senha-aqui
APP_SECRET=
# Responder as mensagens no WhatsApp? (false = só registra e manda o resultado para o log do Discord)
RESPONDER_NO_WHATSAPP=false
GRAPH_VERSION=v23.0
# Cada usuário liga o próprio WhatsApp pelo site (Configurações > WhatsApp). MEU_NUMERO só é usado
# uma vez: quando o app ainda era de um usuário só, esse número passa a ser o do primeiro usuário.
# O simulador (npm run simular) também manda as mensagens como se viessem dele.
MEU_NUMERO=5511999999999
# Número do bot mostrado na tela de vínculo (opcional: sem ele, é consultado na API da Meta)
WHATSAPP_NUMERO_BOT=

# --- Cadastro de novos usuários pelo site (/cadastro) ---
# Código de convite pedido no cadastro (8+ caracteres). Vazio = cadastro fechado.
CODIGO_CONVITE=

# --- Banco de dados ---
# Local: arquivo SQLite. Na nuvem: libsql://seu-banco.turso.io + DATABASE_AUTH_TOKEN
DATABASE_URL=file:financas.db
DATABASE_AUTH_TOKEN=

# --- Orçamento mensal em reais (opcional) ---
# Também só é usado na migração para multiusuário; depois disso, cada um define o seu no painel.
ORCAMENTO_MENSAL=3000

# --- Logs de acesso (opcional) ---
# Webhook de um canal do Discord: Configurações do canal > Integrações > Webhooks > Copiar URL
DISCORD_WEBHOOK_URL=

# E-mail de contato exibido na política de privacidade (/privacidade), exigida pela Meta
CONTATO_PRIVACIDADE=
